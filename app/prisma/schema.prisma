generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CHUXE {
  MaChuXe   Int    @id @default(autoincrement())
  TenChuXe  String
  DiaChi    String
  DienThoai String
  TienNo    Float
  Email     String

  // Quan hệ ngược
  PhieuThu PHIEUTHUTIEN[]
  TiepNhan TIEPNHANXESUA[]
}

model HIEUXE {
  MaHieuXe  Int    @id @default(autoincrement())
  TenHieuXe String

  // Quan hệ ngược
  TiepNhanXeSua        TIEPNHANXESUA[]
  ChiTietBaoCaoDoanhSo CHITIETBAOCAODOANHSO[]
}

model PHIEUTHUTIEN {
  MaPhieuThuTien Int      @id @default(autoincrement())
  NgayThuTien    DateTime
  SoTienThu      Float

  MaChuXe Int
  ChuXe   CHUXE @relation(fields: [MaChuXe], references: [MaChuXe])

  MaTiepNhanXeSua Int
  TiepNhanXeSua   TIEPNHANXESUA @relation(fields: [MaTiepNhanXeSua], references: [MaTiepNhanXeSua])
}

model TIEPNHANXESUA {
  MaTiepNhanXeSua   Int      @id @default(autoincrement())
  MaChuXe           Int
  MaHieuXe          Int
  NgayTiepNhanXeSua DateTime
  BienSo            String

  HieuXe       HIEUXE         @relation(fields: [MaHieuXe], references: [MaHieuXe])
  ChuXe        CHUXE          @relation(fields: [MaChuXe], references: [MaChuXe])
  // Quan hệ ngược
  PhieuThuTien PHIEUTHUTIEN[]
  PhieuSuaChua PHIEUSUACHUA[]
}

model PHIEUSUACHUA {
  MaPhieuSuaChua      Int                   @id @default(autoincrement())
  NgaySuaChua         DateTime
  TongThanhTien       Float
  MaTiepNhanXeSua     Int
  // Quan hệ ngược
  ChiTietPhieuSuaChua CHITIETPHIEUSUACHUA[]
  TiepNhanXeSua       TIEPNHANXESUA         @relation(fields: [MaTiepNhanXeSua], references: [MaTiepNhanXeSua])
}

model CHITIETPHIEUSUACHUA {
  MaChiTietPhieuSuaChua Int    @id @default(autoincrement())
  NoiDung               String
  SoLuong               Int
  DonGia                Float

  MaPhuTung Int
  PhuTung   PHUTUNG @relation(fields: [MaPhuTung], references: [MaPhuTung])

  MaTienCong Int
  TienCong   TIENCONG @relation(fields: [MaTienCong], references: [MaTienCong])

  MaPhieuSuaChua Int
  PhieuSuaChua   PHIEUSUACHUA @relation(fields: [MaPhieuSuaChua], references: [MaPhieuSuaChua])
}

model PHUTUNG {
  MaPhuTung  Int    @id @default(autoincrement())
  TenPhuTung String
  DonGia     Float

  // Quan hệ ngược
  ChiTietPhieuSuaChua CHITIETPHIEUSUACHUA[]
  ChiTietTon          CHITIETBAOCAOTON[]
  ChiTietNhapPhuTung  CHITIETNHAPPHUTUNG[]
}

model TIENCONG {
  MaTienCong  Int    @id @default(autoincrement())
  TenTienCong String
  GiaTienCong Float

  // Quan hệ ngược
  ChiTietPhieuSuaChua CHITIETPHIEUSUACHUA[]
}

model BAOCAODOANHSO {
  MaBaoCaoDoanhSo Int   @id @default(autoincrement())
  Thang           Int
  TongDoanhThu    Float

  // 1 BAOCAODOANHSO có nhiều CHITIETBAOCAODOANHSO
  ChiTietBaoCaoDoanhSo CHITIETBAOCAODOANHSO[]
}

model CHITIETBAOCAODOANHSO {
  MaChiTietBaoCaoDoanhSo Int   @id @default(autoincrement())
  MaHieuXe               Int
  SoLuotSua              Int
  ThanhTien              Float
  TiLe                   Float

  // FK
  MaBaoCaoDoanhSo Int
  BaoCaoDoanhSo   BAOCAODOANHSO @relation(fields: [MaBaoCaoDoanhSo], references: [MaBaoCaoDoanhSo])
  HieuXe          HIEUXE        @relation(fields: [MaHieuXe], references: [MaHieuXe])
}

model BAOCAOTON {
  MaBaoCaoTon Int @id @default(autoincrement())
  Thang       Int

  ChiTietBaoCaoTon CHITIETBAOCAOTON[]
}

model CHITIETBAOCAOTON {
  MaChiTietBaoCaoTon Int @id @default(autoincrement())
  TonDau             Int
  PhatSinh           Int
  TonCuoi            Int

  MaBaoCaoTon Int
  BaoCaoTon   BAOCAOTON @relation(fields: [MaBaoCaoTon], references: [MaBaoCaoTon])

  // FK đến bảng Phụ Tùng nếu có
  MaPhuTung Int
  PhuTung   PHUTUNG @relation(fields: [MaPhuTung], references: [MaPhuTung])
}

model NHAPPHUTUNG {
  MaNhapPhuTung Int      @id @default(autoincrement())
  NgayNhap      DateTime
  TongTienNhap  Float

  // Quan hệ ngược
  ChiTietNhapPhuTung CHITIETNHAPPHUTUNG[]
}

model CHITIETNHAPPHUTUNG {
  MaChiTietNhapPhuTung Int   @id @default(autoincrement())
  SoLuong              Int
  DonGia               Float
  TongDonGia           Float

  MaNhapPhuTung Int
  NhapPhuTung   NHAPPHUTUNG @relation(fields: [MaNhapPhuTung], references: [MaNhapPhuTung])

  MaPhuTung Int
  PhuTung   PHUTUNG @relation(fields: [MaPhuTung], references: [MaPhuTung])
}

model THAM_SO {
  id            Int   @id @default(1)
  TiepNhanToiDa Int
  ThuVuotQuaNo  Float
}
